# Copy this file to .env and fill in the required values before running:
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_before_running

# ── Optional (these defaults match docker-compose.yml) ────────────────────────
POSTGRES_DB=reminders
POSTGRES_USER=reminder_user
LOG_LEVEL=INFO
REMINDER_THRESHOLD_HOURS=48
REMINDER_COOLDOWN_HOURS=24
